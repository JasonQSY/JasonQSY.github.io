source "https://rubygems.org"

# GitHub Pages' dependency bundle currently requires Ruby < 4. Use current
# Jekyll directly so local builds can run on Ruby 4.
gem "jekyll", "~> 4.4"

gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-toc", "~> 0.19"
end

gem "kramdown-parser-gfm", "~> 1.1"

# WEBrick is no longer bundled with Ruby, but Jekyll uses it for `serve`.
gem "webrick", "~> 1.9"
